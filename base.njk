<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ title or site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <meta name="robots" content="index,follow,max-image-preview:large">
  <meta name="theme-color" content="#f8f2eb">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:type" content="website">
  <meta property="og:image" content="/assets/images/main-visual.jpg">
  <link rel="stylesheet" href="/styles.css">
  <script type="application/ld+json">
  {
    "@context":"https://schema.org",
    "@type":"BeautySalon",
    "name":"推しglow 美リンパ",
    "telephone":"090-3006-0095",
    "address":{"@type":"PostalAddress","postalCode":"462-0801","addressRegion":"愛知県","addressLocality":"名古屋市北区","streetAddress":"新堀町26 ベルトピア上飯田102","addressCountry":"JP"},
    "openingHours":"Mo-Su 10:00-20:00",
    "sameAs":["https://www.instagram.com/oshiglow/"]
  }
  </script>
</head>
<body>
<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand"><span>推し</span><em>glow</em><small>美リンパ</small></a>
    <nav>
      <a href="/#concept">コンセプト</a><a href="/#menu">メニュー</a><a href="/#aroma">アロマ</a><a href="/#salon">店内</a><a href="/blog/">ブログ</a><a href="/#access">アクセス</a>
    </nav>
    <a class="reserve-mini" href="tel:{{ site.phoneHref }}">予約・電話</a>
  </div>
</header>
{{ content | safe }}
<footer>
  <div class="wrap footer-grid"><div><strong>{{ site.name }}</strong><p>最高の私で、その瞬間へ。</p></div><div><p>〒{{ site.postal }}<br>{{ site.address }}</p><p>{{ site.hours }} / {{ site.holiday }}</p></div></div>
  <div class="copyright">© 推しglow 美リンパ</div>
</footer>
<div class="floating-actions"><a href="tel:{{ site.phoneHref }}">電話予約</a><a href="{{ site.instagram }}" target="_blank" rel="noopener">Instagram</a></div>
</body>
</html>
