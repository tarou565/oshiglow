<section id="access" class="section access"><div class="wrap access-grid"><div><p class="eyebrow">ACCESS</p><h2>店舗情報</h2><dl><dt>店名</dt><dd>{{ site.name }}</dd><dt>住所</dt><dd>〒{{ site.postal }}<br>{{ site.address }}</dd><dt>営業時間</dt><dd>{{ site.hours }}</dd><dt>定休日</dt><dd>{{ site.holiday }}</dd><dt>電話</dt><dd><a href="tel:{{ site.phoneHref }}">{{ site.phone }}</a></dd></dl><a class="btn primary" href="{{ site.map }}" target="_blank" rel="noopener">Googleマップで見る</a></div><div class="social-card"><img src="/assets/images/instagram-qr.jpg" alt="Instagram QRコード"><h3>{{ site.instagramHandle }}</h3><a href="{{ site.instagram }}" target="_blank" rel="noopener">Instagramを見る →</a><p>ご予約・メニューのご相談は電話・Instagram・LINEにて。</p></div></div></section>
